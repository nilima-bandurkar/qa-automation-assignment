# Copy this file to .env  (command:  copy .env.example .env)
# Do not commit the real .env file.

# Application under test
ORANGEHRM_URL=https://opensource-demo.orangehrmlive.com/

# Demo credentials shown on the OrangeHRM demo site
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Browser
BROWSER=chrome
HEADLESS=false

# Demo mode: highlights each element and pauses, so every click and entry is
# easy to see in the browser. Set DEMO_MODE=false for a fast run.
DEMO_MODE=true
STEP_DELAY=0.5

# Timeouts in seconds
EXPLICIT_WAIT=20
PAGE_LOAD_TIMEOUT=45
API_TIMEOUT=30

# Video recording (needs: pip install -r requirements-video.txt)
RECORD_VIDEO=false
VIDEO_FPS=4

# Public test API, used only if the OrangeHRM API is not reachable
FALLBACK_API_URL=https://reqres.in/api
FALLBACK_API_KEY=reqres-free-v1
